	<string>LongOS Sync đọc số bước, năng lượng hoạt động và giấc ngủ đã được Apple Health tổng hợp để bạn theo dõi sức khỏe cá nhân và đồng bộ vào khu vực LongOS riêng tư khi bạn bật cloud sync.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
